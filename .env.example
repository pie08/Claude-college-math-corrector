# Copy to .env (gitignored) in the repo root and fill in.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Shared secret the app sends to the grading server. Pick any long random string.
API_SHARED_SECRET=

# Optional (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max
# REFUSAL_FALLBACK=on            # off disables the server-side refusal fallback
# MAX_IMAGE_EDGE=2048            # long edge (px) of the image sent to the model
# MIN_SHARPNESS=0                # reject photos below this sharpness score (0 = off)
# DAILY_REQUEST_LIMIT=100
# PORT=8787
