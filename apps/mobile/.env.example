# Copy to .env (gitignored). Expo reads it when bundling; EXPO_PUBLIC_ values
# end up inside the app, so never put the Anthropic API key here.

# Grading server. Over USB: http://localhost:8787 plus `adb reverse tcp:8787 tcp:8787`.
# Over Tailscale: the https://<computer>.<tailnet>.ts.net address from `tailscale serve`.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Must match API_SHARED_SECRET in the repo-root .env.
EXPO_PUBLIC_API_SECRET=
